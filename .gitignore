# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.rar
*.zip
*.7z
*.tar.gz
dist/
build/
*.egg-info/

# Logs and databases
*.log
*.sqlite
*.sqlite3

# Local certificates and private keys (generated at runtime)
client/certs/*.key
client/certs/*.crt
client/certs/domains/*.crt
!client/certs/domains/.gitkeep

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# Environment and local overrides
.env
.env.local
